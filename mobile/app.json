{
  "expo": {
    "name": "Cegin",
    "slug": "cegin",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0E0E0E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E0E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "kitchen.cegin.app",
      "versionCode": 3,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cegin"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
