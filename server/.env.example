# =============================================================================
# Cegin Server Environment
#
# NON-SECRET settings only. API keys and JWT secret go in:
#   - secrets/ directory (Docker Compose secrets — recommended)
#   - Or directly in this .env file (for quick local dev)
#
# See README.md for full setup instructions.
# =============================================================================

# --- AI Provider Selection ---------------------------------------------------
# Choose which provider to use for text and vision.
# Options: "openai-compatible" (DeepSeek, Groq, OpenAI, etc.) or "gemini"

# Option 1: DeepSeek (text) + Gemini (vision) — cheapest
TEXT_PROVIDER=openai-compatible
VISION_PROVIDER=gemini
TEXT_BASE_URL=https://api.deepseek.com/chat/completions
TEXT_MODEL=deepseek-v4-flash
VISION_MODEL=gemini-2.5-flash

# Option 2: OpenAI for both — best quality
# TEXT_PROVIDER=openai-compatible
# VISION_PROVIDER=openai-compatible
# TEXT_BASE_URL=https://api.openai.com/v1/chat/completions
# TEXT_MODEL=gpt-4o-mini
# VISION_BASE_URL=https://api.openai.com/v1/chat/completions
# VISION_MODEL=gpt-4o-mini

# Option 3: Groq (text) + Gemini (vision) — fast + free tier
# TEXT_PROVIDER=openai-compatible
# VISION_PROVIDER=gemini
# TEXT_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# TEXT_MODEL=llama-3.1-70b-versatile
# VISION_MODEL=gemini-2.5-flash

# --- Legacy aliases (still supported as fallbacks) ---------------------------
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_MODEL=gemini-2.5-flash

# --- Database (advanced) -----------------------------------------------------
# DB_PATH=/data/recipes.db   # Already set correctly inside the container

# =============================================================================
# SECRETS — DO NOT PUT IN THIS FILE FOR PRODUCTION
#
# For Docker Compose (recommended):
#   mkdir -p secrets && chmod 700 secrets
#   echo "sk-your-key"           > secrets/TEXT_API_KEY
#   echo "AIza-your-key"         > secrets/VISION_API_KEY
#   echo "random-jwt-secret"     > secrets/JWT_SECRET
#   chmod 600 secrets/*
#
# For quick local dev (no Docker secrets):
#   Just add them below this comment, but DON'T COMMIT this file.
#
# TEXT_API_KEY=
# VISION_API_KEY=
# JWT_SECRET=
# =============================================================================
